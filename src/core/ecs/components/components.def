/* 
- every component needs to be defined here
- the xcomponent( macro will be called by 
component_enums.h       - defines the enum types 
component_storage.h     - add to the component data structure
component_manager.h     - add the functions to add and get component
component_macros.h      - makes it easier to ADD_COMPONENT() 
*/

xcomponent(Transform, 0, (EntityID entity, float x, float y, float rotation, float scale), (x, y, rotation, scale))
xcomponent(Sprite, 1, (EntityID entity, Texture* texture), (texture))
xcomponent(Collider, 3, (EntityID entity, float w, float h, bool staticCollider = false, bool triggerCollider = false), ( w, h, staticCollider, triggerCollider))
xcomponent(Text, 11, (EntityID entity, Font* font, const char* text), (font, text))
xcomponent(UIBox, 12, (EntityID entity, float width, float height), (width, height))
xcomponent(Enemy, 13, (EntityID entity, int health, int _speed), (health, _speed))
xcomponent(Tower, 14, (EntityID entity, TOWER_TYPE t, int r, float CD), (t, r, CD))
xcomponent(TimedSprite, 16, (EntityID entity,float currTime_, float animTime_,  int loop_, int maxSprites_), ( currTime_,  animTime_ ,  loop_,  maxSprites_))
xcomponent(MoveToXY, 17, (EntityID entity, int x, int y, int spd), ( x,  y, spd))
xcomponent(LifeTime, 18, (EntityID entity, float lifeTime), (lifeTime))
xcomponent(JetAnimation, 19, (EntityID entity, int _srcX, int _srcY, int _destX, int _destY), ( _srcX,  _srcY,  _destX,  _destY))
xcomponent(Crowdcontrol, 20, (EntityID entity, EntityID tgt, int _targetX, int _targetY), (tgt,  _targetX,  _targetY))
xcomponent(ChainLightning, 21, (EntityID entity, int _currX,int _currY,int _nextX,int _nextY, EntityID _target, int _damage, int _jumps, bool _explodes), ( _currX, _currY, _nextX, _nextY, _target, _damage, _jumps, _explodes))
xcomponent(EnemyDebug,22, (EntityID entity, TOWER_TYPE t), ( t))
xcomponent(EnemyExit,23, (EntityID entity), ( ))
xcomponent(Target,24, (EntityID entity, EntityID _target), (_target))
xcomponent(ProjectileSpawner,25, (EntityID entity, PROJECTILE_TYPE _type), (_type))
xcomponent(Cooldown,26, (EntityID entity, float _CD), (_CD))
xcomponent(Damage,27, (EntityID entity, int _damage), (_damage))
xcomponent(ExplodeOnXY,28, (EntityID entity,int _x, int _y), ( _x,  _y))
xcomponent(DamageOnCollision,29, (EntityID entity), ())
xcomponent(Element,30, (EntityID entity, ELEMENT new_ele), (new_ele))
xcomponent(ResolveElement,31, (EntityID entity), ())
xcomponent(AddSlowOnCollision,32, (EntityID entity, float duration, float intensity), (duration, intensity))
xcomponent(Slow,33, (EntityID entity, float duration, float intensity), (duration, intensity))
